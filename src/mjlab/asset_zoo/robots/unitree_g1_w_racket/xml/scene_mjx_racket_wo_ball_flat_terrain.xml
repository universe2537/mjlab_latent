<mujoco model="g1 scene">
    <!--
      持拍 G1 的独立平地可视化场景。

      mjlab 训练任务通常通过 g1_constants.py 加载机器人，并在 Python 中构建完整
      场景。这个 XML 仍可用于直接在 MuJoCo 中检查模型，因为它包含简单 floor、
      灯光、可视化设置和 keyframes。
    -->
    <include file="g1_mjx_w_racket_wo_ball.xml"/>

    <statistic center="0 0 0.7" extent="1.2" meansize="0.04"/>

    <visual>
        <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
        <rgba force="1 0 0 1"/>
        <global azimuth="140" elevation="-20"/>
        <map force="0.01"/>
        <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
        <quality shadowsize="8192"/>
    </visual>

    <asset>
        <!-- 白色 checker 地面：保持尽量简单，便于在不加载任务专用 terrain 资产的
             情况下检查迁移后的机器人和球拍几何。 -->
        <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="1 1 1" rgb2="1 1 1"
                 markrgb="0 0 0" width="300" height="300"/>
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
    </asset>

    <worldbody>
        <!-- 场景级 floor。机器人 XML 不能直接引用这个 geom，否则将机器人单独作为
             mjlab Entity 编译时会失败。 -->
        <geom name="floor" size="0 0 0.01" type="plane" material="groundplane"/>
    </worldbody>

    <keyframe>
        <!-- keyframes 只定义 qpos。机器人 XML 没有内嵌 actuators，因为 mjlab 会
             通过程序化方式添加；scene keyframes 不写 ctrl，可以让这个独立场景在
             nu=0 时正常编译。 -->
        <key name="home"
             qpos="
      0 0 0.785
      1 0 0 0
      -0.1 0 0 0.3 -0.2 0
      -0.1 0 0 0.3 -0.2 0
      0 0 0
      0.2 0.2 0 1.28 0 0 0
      0.2 -0.2 0 1.28 0 0 0
       "/>
        <key name="knees_bent"
             qpos="
      0 0 0.755
      1 0 0 0
      -0.312 0 0 0.669 -0.363 0
      -0.312 0 0 0.669 -0.363 0
      0 0 0.073
      0.2 0.2 0 0.6 0 0 0
      0.2 -0.2 0 0.6 0 0 0
      "/>
    </keyframe>
</mujoco>
