<mujoco model="g1 tennis return scene">
    <include file="g1_w_racket.xml"/>

    <statistic center="0 0 0.8" extent="5.0" meansize="0.04"/>

    <visual>
        <headlight diffuse=".8 .8 .8" ambient=".2 .2 .2" specular="1 1 1"/>
        <rgba force="1 0 0 1"/>
        <global azimuth="140" elevation="-18"/>
        <map force="0.01"/>
        <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
        <quality shadowsize="8192"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="1 1 1" rgb2="1 1 1" width="800" height="800"/>
        <texture type="2d" name="tennis_court_texture" builtin="checker" mark="edge" rgb1="0.13 0.42 0.22" rgb2="0.10 0.32 0.18"
                 markrgb="0.9 0.9 0.9" width="300" height="300"/>
        <material name="tennis_court" texture="tennis_court_texture" texuniform="true" texrepeat="2 2" reflectance="0"/>
        <material name="tennis_ball_mat" rgba="0.85 1.0 0.05 1"/>
        <material name="tennis_net_mat" rgba="0.05 0.05 0.05 0.35"/>
        <material name="tennis_target_mat" rgba="0.2 0.45 1.0 0.35"/>
        <material name="court_line_mat" rgba="0.95 0.95 0.95 1"/>
    </asset>

    <worldbody>
        <geom name="floor" size="0 0 0.01" type="plane" material="tennis_court" friction="0.8 0.005 0.0001"/>

        <geom name="court_visual" type="box" pos="-1.0 0 0.002" size="4.5 2.5 0.002"
              material="tennis_court" contype="0" conaffinity="0"/>
        <geom name="court_center_line" type="box" pos="0 0 0.006" size="0.01 2.5 0.003"
              material="court_line_mat" contype="0" conaffinity="0"/>
        <geom name="court_left_sideline" type="box" pos="-1.0 2.5 0.006" size="4.5 0.01 0.003"
              material="court_line_mat" contype="0" conaffinity="0"/>
        <geom name="court_right_sideline" type="box" pos="-1.0 -2.5 0.006" size="4.5 0.01 0.003"
              material="court_line_mat" contype="0" conaffinity="0"/>
        <geom name="court_near_baseline" type="box" pos="-5.5 0 0.006" size="0.01 2.5 0.003"
              material="court_line_mat" contype="0" conaffinity="0"/>
        <geom name="court_far_baseline" type="box" pos="3.5 0 0.006" size="0.01 2.5 0.003"
              material="court_line_mat" contype="0" conaffinity="0"/>

        <geom name="tennis_net_collision" type="box" pos="0 0 0.457" size="0.02 2.8 0.457"
              material="tennis_net_mat" contype="1" conaffinity="1"/>
        <geom name="tennis_net_top_band" type="box" pos="0 0 0.914" size="0.035 2.85 0.02"
              rgba="0.95 0.95 0.95 1" contype="0" conaffinity="0"/>

        <geom name="target_landing_region" type="cylinder" pos="-3.0 0 0.012" size="0.8 0.004"
              material="tennis_target_mat" contype="0" conaffinity="0"/>
        <site name="target_landing_center" pos="-3.0 0 0.03" size="0.03" rgba="0.2 0.45 1.0 1"/>

        <body name="tennis_ball_body" pos="2.8 -0.35 1.25">
            <freejoint name="tennis_ball_freejoint"/>
            <geom name="tennis_ball" type="sphere" size="0.0335" mass="0.057"
                  material="tennis_ball_mat" condim="3" friction="0.8 0.005 0.0001"
                  solref="0.004 1" solimp="0.9 0.95 0.001"/>
            <site name="tennis_ball_center" size="0.01" rgba="0.85 1.0 0.05 1"/>
        </body>
    </worldbody>

    <contact>
        <pair geom1="tennis_ball" geom2="tennis_racket_collision" condim="3"
              friction="0.25 0.005 0.0001" solref="0.002 1" solimp="0.9 0.95 0.001"/>
        <pair geom1="tennis_ball" geom2="floor" condim="3"
              friction="0.8 0.005 0.0001" solref="0.008 0.85" solimp="0.85 0.92 0.001"/>
        <pair geom1="tennis_ball" geom2="tennis_net_collision" condim="3"
              friction="0.5 0.005 0.0001" solref="0.003 1" solimp="0.9 0.95 0.001"/>
    </contact>

</mujoco>
